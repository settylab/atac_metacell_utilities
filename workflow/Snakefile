rule meta_mtx:
    params:
        to_compare = to_compare_str,
        seacell_label = config['anndata']["SEACell_label"],
        cell_type_obs = config["diff_acc"]["cell_type_obs"],
        out_dir = expand("{dirname}diff_acc/", dirname=output_dir)
    output:
        mtx = expand("{dirname}diff_acc/meta_{modality}_X.mtx", dirname=output_dir, modality = modality),
        cells = expand("{dirname}diff_acc/meta_{modality}_cells.csv", dirname=output_dir, modality = modality),
        peaks = expand("{dirname}diff_acc/meta_{modality}_peaks.csv", dirname=output_dir, modality = modality),
        metadata = expand("{dirname}diff_acc/meta_{modality}_metadata.csv", dirname=output_dir, modality = modality)
    conda:
        "../envs/environment.yaml"
    script:
        "scripts/meta_mtx.py"
