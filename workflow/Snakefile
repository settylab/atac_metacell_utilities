# ---- Peak Selection Rule --- #
# Uses anndata_write=1 to serialize writes to shared h5ad files across lineages
rule peak_selection:
    input:
        gp = expand("{dirname}gp_corrs/.gp_corr", dirname=output_dir),
        da = expand("{dirname}diff_acc/.diff_acc", dirname=output_dir),
        op = expand("{dirname}ct_open_peaks/.ct_open_peaks", dirname=output_dir),
        sc_atac = config["anndata"]["sc_atac"],
        meta_atac = config["anndata"]["atac"],
    params:
        lineage_name = lambda wc: wc.lineage,
        target_celltype = lambda wc: targets[wc.lineage]["target_celltype"],
        start = peak_select["start"],
        reference = lambda wc: targets[wc.lineage]["reference"],
        min_logFC = peak_select['min_logFC'],
        max_logFC = peak_select['max_logFC'],
        min_corr = config["gene_peak_corr_cutoffs"]["min_corr"],
        max_pval = config["gene_peak_corr_cutoffs"]["max_pval"]
    resources:
        anndata_write = 1
    output:
        expand("{dirname}peak_selection/{{lineage}}/.peak_selection", dirname=output_dir)
    conda:
        "../envs/environment.yaml"
    script:
        "scripts/peak_selection.py"

# --- Weighted average scoring rule --- #

rule peak_scores:
    input:
        peak_selection = expand(
            "{dirname}peak_selection/{{lineage}}/.peak_selection", dirname=output_dir)
    params:
        lineage_name = lambda wc: wc.lineage,
        min_corr = config["gene_peak_corr_cutoffs"]["min_corr"],
        max_pval = config["gene_peak_corr_cutoffs"]["max_pval"],
        min_peaks = config["gene_peak_corr_cutoffs"]["min_peaks"],
    resources:
        anndata_write = 1
    output:
        expand("{dirname}peak_scores/{{lineage}}/.peak_scores", dirname=output_dir)
    conda:
        "../envs/environment.yaml"
    script:
        "scripts/primed_lin_scores.py"
        
# Standalone target: run peak_selection for all lineages without triggering
# compute_ins_chip or downstream rules. Invoke with: snakemake run_peak_selection
rule run_peak_selection:
    input:
        expand("{dirname}peak_selection/{lineage}/.peak_selection",
            dirname=output_dir, lineage=targets.keys())


# ---- In Silico ChIP Rules ---- #
# Uses anndata_write=1 to serialize writes to shared h5ad files across lineages
rule compute_ins_chip:
    input:
        peak_tf = expand("{dirname}peak_tf/.peak_tf", dirname=output_dir),
        peak_selection = expand(
            "{dirname}peak_selection/{{lineage}}/.peak_selection", dirname=output_dir)
    params:
        verbose = config["ins_chip"]["verbose"],
        lineage_name = lambda wc: wc.lineage,
    resources:
        anndata_write = 1
    output:
        expand("{dirname}ins_chip/{{lineage}}/.ins_chip", dirname=output_dir)
    conda:
        "../envs/environment.yaml"
    script:
        "scripts/compute_ins_chip.py"
        
