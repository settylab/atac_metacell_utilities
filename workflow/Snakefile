import os

configfile: "config/D1_Config.yaml"

output_dir = config["output"]
peak_select = config["peak_selection"]
targets = peak_select["targets"]
modality = config['modality']

def get_all_comparisons(targets_config):
    """Auto-generate pairwise comparisons needed for diff_acc from targets config."""
    comparisons = set()
    for lineage_cfg in targets_config.values():
        target_ct = lineage_cfg["target_celltype"]
        start_ct = peak_select["start"]
        for ref_ct in lineage_cfg["reference"].values():
            comparisons.add((ref_ct, target_ct))
            comparisons.add((ref_ct, start_ct))
    return comparisons


all_comparisons = get_all_comparisons(targets)
to_compare_str = "/".join(f"{a},{b}" for a, b in all_comparisons)
extra = config["diff_acc"]["extra_comparisons"]
if extra:
    to_compare_str = to_compare_str + "/" + extra


# ---- Main Rule ---- #
rule all:
    input:
        chromvar_outdir = expand(
            "{dirname}chromvar_output/", dirname=output_dir),
        score = expand(
            "{dirname}peak_scores/{lineage}/.peak_scores",
            dirname=output_dir, lineage=targets.keys()),
        gene_x_tf = expand("{dirname}gene_x_tf/{lineage}/.gene_x_tf",
            dirname=output_dir, lineage=targets.keys())
# ---- Genome Download Rule ---- #

rule dl_hg38:
    shell:
        "mkdir -p data && wget https://dp-lab-data-public.s3.amazonaws.com/SEACells-multiome/hg38.gtf -O data/hg38.gtf"

