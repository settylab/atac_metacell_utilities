rule prep_chromvar:
    input:
        ins_chip_out = expand("{dirname}ins_chip/.ins_chip", dirname=output_dir),
    params:
        min_chip = config["ins_chip"]["min_chip_score"],
        min_peak_hits = config["ins_chip"]["min_peak_hits"]
    output:
        bin_ins_chip = expand("{dirname}chromvar_input/bin_ins_chip.mtx", dirname=output_dir),
        chromvar_tf_names = expand("{dirname}chromvar_input/chromvar_tf_names.txt", dirname=output_dir),
        sc_atac_counts = expand("{dirname}chromvar_input/sc_atac_counts.mtx", dirname=output_dir),
        sc_nfrags= expand("{dirname}chromvar_input/sc_nfrags.csv", dirname=output_dir)
    conda:
        "../envs/environment.yaml"
    script:
        "scripts/prep_chromVAR_files.py"

rule chromvar:
    input:
        sc_rna = config["anndata"]["sc_rna"],
        peak_file = expand("{dirname}peaks.bed", dirname=output_dir),
        bin_ins_chip = expand("{dirname}chromvar_input/bin_ins_chip.mtx", dirname=output_dir),
        chromvar_tf_names = expand("{dirname}chromvar_input/chromvar_tf_names.txt", dirname=output_dir),
        sc_atac_counts = expand("{dirname}chromvar_input/sc_atac_counts.mtx", dirname=output_dir),
        sc_nfrags= expand("{dirname}chromvar_input/sc_nfrags.csv", dirname=output_dir),
        script = config["scripts"] + "run_chromvar.R",
        pyscript = config["scripts"] + "run_chromvar.py"
    params:
        genome = config["peaks"]["genome"],
        chromvar_indir = directory(
            expand("{dirname}chromvar_output/", dirname=output_dir))
    output:
        chromvar_outdir = directory(
            expand("{dirname}chromvar_output/", dirname=output_dir))
    shell:
        """
        mkdir -p {output.chromvar_outdir}
        Rscript {input.script} {input.peak_file} {params.chromvar_indir} {output.chromvar_outdir} {params.genome}
        python {input.pyscript} --sc_rna {input.sc_rna} --input {output.chromvar_outdir}
        """

# ---- Computation Rule ---- #
rule gene_x_tf:
    input:
        ins_chip = expand("{dirname}ins_chip/.ins_chip", dirname=output_dir),
        gp_dir = expand("{dirname}gp_corrs/", dirname=output_dir),
    params:
        min_corr = config["gene_peak_corr_cutoffs"]["min_corr"],
        max_pval = config["gene_peak_corr_cutoffs"]["max_pval"],
        min_peaks = config["gene_peak_corr_cutoffs"]["min_peaks"]
    output:
       expand("{dirname}gene_x_tf/.gene_x_tf", dirname=output_dir)
    conda:
        "../envs/environment.yaml"
    script:
        "scripts/compute_gene_tf.py"

# ---- Cleaning Rule ---- #
rule clean:
    params:
        out_dir = output_dir + "*"
    run:
        if config["interactive_clean"]:
            shell("rm -ri {params.out_dir}")
        else:
            shell("rm -r {params.out_dir}")
