# ---- Computation Rule ---- #
# Uses anndata_write=1 to serialize writes to shared h5ad files across lineages
rule gene_x_tf:
    input:
        ins_chip = expand("{dirname}ins_chip/{{lineage}}/.ins_chip", dirname=output_dir),
        gp_dir = expand("{dirname}gp_corrs/.gp_corr", dirname=output_dir),
    params:
        lineage_name = lambda wc: wc.lineage,
        min_corr = config["gene_peak_corr_cutoffs"]["min_corr"],
        max_pval = config["gene_peak_corr_cutoffs"]["max_pval"],
        min_peaks = config["gene_peak_corr_cutoffs"]["min_peaks"]
    resources:
        anndata_write = 1
    output:
        expand("{dirname}gene_x_tf/{{lineage}}/.gene_x_tf", dirname=output_dir)
    conda:
        "../envs/environment.yaml"
    script:
        "scripts/compute_gene_tf.py"
        
        
# ---- Cleaning Rule ---- #
rule clean:
    params:
        out_dir = output_dir + "*"
    run:
        if config["interactive_clean"]:
            shell("rm -ri {params.out_dir}")
        else:
            shell("rm -r {params.out_dir}")

