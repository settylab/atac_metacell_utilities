rule prep_chromvar:
    input:
        ins_chip_out = expand("{dirname}ins_chip/{{lineage}}/.ins_chip", dirname=output_dir),
    params:
        lineage_name = lambda wc: wc.lineage,
        min_chip = config["ins_chip"]["min_chip_score"],
        min_peak_hits = config["ins_chip"]["min_peak_hits"]
    output:
        bin_ins_chip = expand("{dirname}chromvar_input/{{lineage}}/bin_ins_chip.mtx", dirname=output_dir),
        chromvar_tf_names = expand("{dirname}chromvar_input/{{lineage}}/chromvar_tf_names.txt", dirname=output_dir),
        sc_atac_counts = expand("{dirname}chromvar_input/{{lineage}}/sc_atac_counts.mtx", dirname=output_dir),
        sc_nfrags = expand("{dirname}chromvar_input/{{lineage}}/sc_nfrags.csv", dirname=output_dir)
    conda:
        "../envs/environment.yaml"
    script:
        "scripts/prep_chromVAR_files.py"
        
rule run_chromvar:
    input:
        peak_file = expand("{dirname}peaks.bed", dirname=output_dir),
        # Barrier: wait for all per-lineage prep_chromvar outputs
        _chromvar_barrier = expand("{dirname}chromvar_input/{lineage}/bin_ins_chip.mtx",
                                  dirname=output_dir, lineage=targets.keys()),
    params:
        genome = config["peaks"]["genome"],
        # Use first lineage's chromvar_input dir (InSilicoChip is identical across lineages)
        chromvar_indir = expand("{dirname}chromvar_input/{first_lineage}/",
                               dirname=output_dir, first_lineage=list(targets.keys())[0])
    output:
        chromvar_outdir = directory(
            expand("{dirname}chromvar_output/", dirname=output_dir))
    conda:
        "../envs/R-4.1.0_environment.yaml"
    script:
        "scripts/run_chromvar.R"

