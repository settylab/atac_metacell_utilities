    conda:
     "../envs/R-4.1.0_environment.yaml"
    shell:
        """
        R -e 'renv::init(bare=TRUE)'
        R -e 'renv::restore(lockfile=\"envs/renv.lock\")'
        """

# ---- Preparation Rules ---- #

rule prepare_peak_file:
    input:
        atac = ancient(config["anndata"]["atac"])
    output:
        expand("{dirname}peaks.bed", dirname=output_dir)
    conda:
        "../envs/environment.yaml"
    script:
        "scripts/prepare_peak_file.py"

rule all_seqs:
    input:
        peaks = expand("{dirname}peaks.bed", dirname=output_dir),
        script = config["scripts"] + "seq_gl.R"
    params:
        span = config["peaks"]["width"],
        genome = config["peaks"]["genome"]
    output:
        expand("{dirname}all_seqs.fa", dirname=output_dir)
    conda:
        "../envs/R-4.1.0_environment.yaml"
    script:
        "scripts/seq_gl.R"
        
rule fimo:
    input:
        meme = config["peaks"]["meme_file"],
        seqs = expand("{dirname}all_seqs.fa", dirname=output_dir)
    output:
        expand("{dirname}fimo_result/fimo.tsv", dirname=output_dir)
    params:
        fimo_dir = directory(
                expand("{dirname}fimo_result/", dirname=output_dir))
    log:
        out = config["logs"] + "fimo.out"
    shell:
        """
        ml MEME/5.1.1-foss-2019b-Perl-5.30.0-Python-3.7.4
        fimo -oc {params.fimo_dir} {input.meme} {input.seqs} 2> {log.out}
        rm -f {params.fimo_dir}/cisml.xml
        """

